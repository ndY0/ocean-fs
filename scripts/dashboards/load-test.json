          "expr": "histogram_quantile(0.50, sum(rate(s3_request_latency_seconds_bucket{job=\"oceanfs\"}[5m])) by (le))",
          "legendFormat": "p50",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(s3_request_latency_seconds_bucket{job=\"oceanfs\"}[5m])) by (le))",
          "legendFormat": "p99",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "S3 Request Latency",
      "description": "Histogram quantiles over 5-minute windows. p50 should be sub-10ms; p99 should stay under 500ms.",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-GrYlRd" },
          "custom": {
            "fillOpacity": 70,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineWidth": 0,
            "spanNulls": true
          },
          "mappings": [
            {
              "options": { "1": { "color": "blue", "index": 0, "text": "Phase 1 — Concurrency" } },
              "type": "value",
              "value": "1"
            },
            {
              "options": { "2": { "color": "green", "index": 1, "text": "Phase 2 — Sustained" } },
              "type": "value",
              "value": "2"
            },
            {
              "options": { "3": { "color": "orange", "index": 2, "text": "Phase 3 — Churn" } },
              "type": "value",
              "value": "3"
            },
            {
              "options": { "4": { "color": "red", "index": 3, "text": "Phase 4 — Degraded" } },
              "type": "value",
              "value": "4"
            },
            {
              "options": { "5": { "color": "purple", "index": 4, "text": "Phase 5 — Scale" } },
              "type": "value",
              "value": "5"
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "none"
        }
      },
